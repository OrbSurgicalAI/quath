lemma ServerCycleApproval [reuse,
                           hide_lemma=InjectiveKeyAgreement]:
  all-traces
  "∀ S I newK oldK #x.
    (((AnswerCycleRequest( S, I, pk(newK), pk(oldK) ) @ #x) ∧
      (¬(∃ #r. LtkReveal( S ) @ #r))) ∧
     (¬(∃ #r. LtkReveal( I ) @ #r))) ⇒
    ((((∃ k_o a_o #r. NewClientRegistry( S, I, k_o, a_o ) @ #r) ∧
       (∃ #r. (ServerSessionKey( S, I, pk(oldK) ) @ #r) ∧ (#r < #x))) ∧
      (¬(∃ #r.
          (InvalidateServerSessionKey( S, I, pk(oldK) ) @ #r) ∧
          (#r < #x)))) ∧
     (∃ #y. (OwnsKey( I, oldK ) @ #y) ∧ (#y < #x)))"
/*
guarded formula characterizing all counter-examples:
"∃ S I newK oldK #x.
  (AnswerCycleRequest( S, I, pk(newK), pk(oldK) ) @ #x)
 ∧
  (∀ #r. (LtkReveal( S ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (LtkReveal( I ) @ #r) ⇒ ⊥) ∧
  (((∀ k_o a_o #r. (NewClientRegistry( S, I, k_o, a_o ) @ #r) ⇒ ⊥) ∨
    (∀ #r. (ServerSessionKey( S, I, pk(oldK) ) @ #r) ⇒ ¬(#r < #x)) ∨
    (∃ #r.
      (InvalidateServerSessionKey( S, I, pk(oldK) ) @ #r) ∧ #r < #x) ∨
    (∀ #y. (OwnsKey( I, oldK ) @ #y) ⇒ ¬(#y < #x))))"
*/
simplify
solve( (∀ k_o a_o #r.
         (NewClientRegistry( $S, ~I, k_o, a_o ) @ #r) ⇒ ⊥)  ∥
       (∀ #r. (ServerSessionKey( $S, ~I, pk(oldK) ) @ #r) ⇒ ¬(#r < #x))  ∥
       (∃ #r.
         (InvalidateServerSessionKey( $S, ~I, pk(oldK) ) @ #r) ∧ #r < #x)  ∥
       (∀ #y. (OwnsKey( ~I, oldK ) @ #y) ⇒ ¬(#y < #x)) )
  case case_1
  solve( SClientRecord( $S, ~I, pk(oldK), %client_time, 'init'
         ) ▶₁ #x )
    case Server_register
    by contradiction /* from formulas */
  qed
next
  case case_2
  solve( SClientRecord( $S, ~I, pk(oldK), %client_time, 'init'
         ) ▶₁ #x )
    case Server_register
    by contradiction /* from formulas */
  qed
next
  case case_3
  solve( SClientRecord( $S, ~I, pk(oldK), %client_time, 'init'
         ) ▶₁ #x )
    case Server_register
    solve( SClientRecord( $S, ~I, pk(oldK), %client_time, 'init'
           ) ▶₁ #r )
      case Server_register
      by contradiction /* cyclic */
    qed
  qed
next
  case case_4
  solve( SClientRecord( $S, ~I, pk(oldK), %client_time, 'init'
         ) ▶₁ #x )
    case Server_register
    solve( !KU( sign(<'CYCLE', ~I, pk(newK)>, newK) ) @ #vk.8 )
      case Client_cycle_1
      solve( !KU( sign(sign(<'CYCLE', ~I, pk(~k2)>, ~k2), oldK)
             ) @ #vk.10 )
        case Client_cycle_1
        by contradiction /* from formulas */
      next
        case c_sign
        solve( !KU( sign(<'REGISTER', ~I, pk(oldK), ~admin>, oldK)
               ) @ #vk.17 )
          case Client_register_1
          by contradiction /* from formulas */
        next
          case c_sign
          solve( !KU( sign(sign(<'REGISTER', ~I, pk(oldK), ~admin>, oldK),
                           ~k)
                 ) @ #vk.18 )
            case Client_register_1
            by contradiction /* from formulas */
          next
            case c_sign
            by solve( !KU( ~k ) @ #vk.25 )
          qed
        qed
      qed
    next
      case c_sign
      solve( !KU( sign(sign(<'CYCLE', ~I, pk(newK)>, newK), oldK)
             ) @ #vk.10 )
        case Client_cycle_1
        by contradiction /* from formulas */
      next
        case c_sign
        solve( !KU( sign(<'REGISTER', ~I, pk(oldK), ~admin>, oldK)
               ) @ #vk.17 )
          case Client_register_1
          by contradiction /* from formulas */
        next
          case c_sign
          solve( !KU( sign(sign(<'REGISTER', ~I, pk(oldK), ~admin>, oldK),
                           ~k)
                 ) @ #vk.18 )
            case Client_register_1
            by contradiction /* from formulas */
          next
            case c_sign
            by solve( !KU( ~k ) @ #vk.21 )
          qed
        qed
      qed
    qed
  qed
qed

lemma NoVerificationPostExpiry [use_induction, reuse]:
  all-traces
  "¬(∃ S t #i #j.
      ((VerifiesToken( S, h(t) ) @ #i) ∧ (ExpireToken( S, h(t) ) @ #j)) ∧
      (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ S t #i #j.
  (VerifiesToken( S, h(t) ) @ #i) ∧ (ExpireToken( S, h(t) ) @ #j)
 ∧
  #j < #i"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( ValidToken( $S, h(t), 'active' ) ▶₀ #i )
    case Server_tok
    by solve( ValidToken( $S,
                          h(<$p1, $p2, ~I, %client_time, $perms, ~ss>), 'active'
              ) ▶₀ #j )
  qed
qed

lemma NoVerificationPostRevoke [use_induction, reuse]:
  all-traces
  "¬(∃ S t #i #j.
      ((VerifiesToken( S, h(t) ) @ #i) ∧
       (RevokedToken( S, h(t) ) @ #j)) ∧
      (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ S t #i #j.
  (VerifiesToken( S, h(t) ) @ #i) ∧ (RevokedToken( S, h(t) ) @ #j)
 ∧
  #j < #i"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( ValidToken( $S, h(t), 'active' ) ▶₀ #i )
    case Server_tok
    by solve( ValidToken( $S,
                          h(<$p1, $p2, ~I, %client_time, $perms, ~ss>), 'active'
              ) ▶₀ #j )
  qed
qed

lemma SecrecyForward [reuse]:
  all-traces
  "∀ S I k #i.
    (((SessionKey( S, I, k ) @ #i) ∧ (¬(∃ #r. LtkReveal( I ) @ #r))) ∧
     (¬(∃ #r. InvalidateKey( I, k ) @ #r))) ⇒
    (¬(∃ #j. K( k ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ S I k #i.
  (SessionKey( S, I, k ) @ #i)
 ∧
  (∀ #r. (LtkReveal( I ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (InvalidateKey( I, k ) @ #r) ⇒ ⊥) ∧
  (∃ #j. (K( k ) @ #j))"
*/
simplify
solve( SessionKey( S, I, k ) @ #i )
  case Client_cycle_2
  solve( (∃ #r. (LtkReveal( $S ) @ #r))  ∥
         (∃ #y. (OwnsKey( ~I, ~k ) @ #y) ∧ #y < #i) )
    case case_1
    solve( (∃ #r. (LtkReveal( $S ) @ #r))  ∥
           (∃ #y. (SessionKey( $S, ~I, ~oldK ) @ #y) ∧ #y < #i) )
      case case_1
      solve( ClientState( $S, ~I, %local, <'cycling', ~k, ~oldK>
             ) ▶₀ #i )
        case Client_cycle_1
        solve( (∃ #r. (LtkReveal( $S ) @ #r))  ∥
               (∃ #r. (LtkReveal( ~I ) @ #r))  ∥
               ((∃ #j. (Running( $S, ~I, pk(~oldK) ) @ #j) ∧ #j < #vr.1) ∧
                (∀ S2 I2 #i2. (Commit( S2, I2, pk(~oldK) ) @ #i2) ⇒ #vr.1 = #i2)) )
          case case_1
          solve( !Pk( $S, pk(x) ) ▶₁ #i )
            case Register_pk
            solve( OwnsKey( ~I, ~k ) @ #y )
              case Client_cycle_1
              solve( LtkReveal( $S ) @ #r )
                case Reveal_ltk
                solve( !Ltk( $S, ltk.1 ) ▶₀ #r )
                  case Register_pk
                  solve( OwnsKey( ~I, ~oldK ) @ #y.1 )
                    case Client_register_1
                    solve( OwnsKey( ~I, ~oldK ) @ #y.1 )
                      case Client_register_1
                      solve( !KU( ~k ) @ #vk )
                        case Reveal_client
                        by contradiction /* from formulas */
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        next
          case case_2
          by contradiction /* from formulas */
        next
          case case_3
          solve( !Pk( $S, pk(x) ) ▶₁ #i )
            case Register_pk
            solve( !Ltk( $S, ~ltkS ) ▶₀ #j.1 )
              case Register_pk
              solve( !AdminPublic( $S, ~admin, pk(x) ) ▶₁ #j.1 )
                case Register_Authorized_User
                solve( OwnsKey( ~I, ~k ) @ #y )
                  case Client_cycle_1
                  solve( LtkReveal( $S ) @ #r )
                    case Reveal_ltk
                    solve( !Ltk( $S, ltk.1 ) ▶₀ #r )
                      case Register_pk
                      solve( OwnsKey( ~I, ~oldK ) @ #y.1 )
                        case Client_register_1
                        solve( OwnsKey( ~I, ~oldK ) @ #y.1 )
                          case Client_register_1
                          solve( !KU( ~k ) @ #vk )
                            case Reveal_client
                            by contradiction /* from formulas */
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
