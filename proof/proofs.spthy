theory Fluid begin

// Function signature and definition of the equational theory E

builtins: natural-numbers
functions: adec/2, aenc/2, fst/1, h/1, kemdecaps/3, kemencaps/3,
           kempk/2, pair/2, pk/1, sdec/2, senc/2, sign/2, snd/1, true/0,
           verify/3
equations:
    adec(aenc(x.1, pk(x.2)), x.2) = x.1,
    fst(<x.1, x.2>) = x.1,
    kemdecaps(g, kemencaps(g, ss, kempk(g, sk)), sk) = ss,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true















restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

restriction unique:
  "∀ x #i #j.
    ((UniqueFact( x ) @ #i) ∧ (UniqueFact( x ) @ #j)) ⇒ (#i = #j)"
  // safety formula

rule (modulo E) Register_pk:
   [ Fr( ~ltk ) ] --> [ !Ltk( $A, ~ltk ), !Pk( $A, pk(~ltk) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Get_pk:
   [ !Pk( A, pubkey ) ] --> [ Out( pubkey ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_ltk:
   [ !Ltk( A, ltk ) ]
  --[ LtkReveal( A ), Reveal( A ) ]->
   [ Out( ltk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_client:
   [ !ClientKey( ~I, ~k ) ] --[ LtkReveal( ~I ) ]-> [ Out( ~k ) ]

  /* has exactly the trivial AC variant */

restriction OnlyOnce:
  "∀ t #a #b.
    ((OnlyOnce( t ) @ #a) ∧ (OnlyOnce( t ) @ #b)) ⇒ (#a = #b)"
  // safety formula

rule (modulo E) Register_Authorized_User:
   [ Fr( ~user ), Fr( ~k ) ]
  -->
   [ !AdminPublic( $A, ~user, pk(~k) ), !AdminPrivate( $A, ~user, ~k )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) NewTime:
   [ Fr( ~t ) ] --> [ FreshTime( ~t ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_token:
   [ !GlobalToken( $S, token ) ]
  --[ RevealToken( $S, token ) ]->
   [ Out( token ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Client_register_1:
   [
   Fr( ~I ), Fr( ~k ), !Pk( $S, pkS ),
   !AdminPrivate( $S, ~admin, ~admin_k )
   ]
  --[ OnlyOnce( <'REG_ID', ~I> ), OwnsKey( ~I, ~k ) ]->
   [
   ClientState( $S, ~I, %1, <'registering', ~k> ),
   Out( <<'REGISTER', ~I, pk(~k), ~admin>, 
         sign(<'REGISTER', ~I, pk(~k), ~admin>, ~k), 
         sign(sign(<'REGISTER', ~I, pk(~k), ~admin>, ~k), ~admin_k)>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Server_register:
   [
   !Ltk( $S, ~ltkS ), !AdminPublic( $S, ~admin, admin_pk ),
   In( <<'REGISTER', ~I, k, ~admin>, k_proof, a_proof> )
   ]
  --[
  Eq( verify(k_proof, <'REGISTER', ~I, k, ~admin>, k), true ),
  Eq( verify(a_proof, k_proof, admin_pk), true ), UniqueFact( ~I ),
  UniqueFact( k ), NewClientRegistry( $S, ~I, k, admin_pk ),
  ServerSessionKey( $S, ~I, k ), Running( $S, ~I, k )
  ]->
   [
   SClientRecord( $S, ~I, k, %1, 'init' ),
   Out( <<'REG_SUCCESS', h(~I)>, sign(<'REG_SUCCESS', h(~I)>, ~ltkS)>
   )
   ]

  /*
  rule (modulo AC) Server_register:
     [
     !Ltk( $S, ~ltkS ), !AdminPublic( $S, ~admin, admin_pk ),
     In( <<'REGISTER', ~I, k, ~admin>, k_proof, a_proof> )
     ]
    --[
    Eq( z, true ), Eq( z.1, true ), UniqueFact( ~I ), UniqueFact( k ),
    NewClientRegistry( $S, ~I, k, admin_pk ),
    ServerSessionKey( $S, ~I, k ), Running( $S, ~I, k )
    ]->
     [
     SClientRecord( $S, ~I, k, %1, 'init' ),
     Out( <<'REG_SUCCESS', h(~I)>, sign(<'REG_SUCCESS', h(~I)>, ~ltkS)>
     )
     ]
    variants (modulo AC)
    1. ~I    = ~I.21
       ~admin
             = ~admin.22
       a_proof
             = a_proof.24
       admin_pk
             = admin_pk.25
       k     = k.26
       k_proof
             = k_proof.27
       z     = verify(k_proof.27, <'REGISTER', ~I.21, k.26, ~admin.22>,
                      k.26)
       z.1   = verify(a_proof.24, k_proof.27, admin_pk.25)
    
    2. ~I    = ~I.40
       ~admin
             = ~admin.41
       a_proof
             = sign(k_proof.46, x.77)
       admin_pk
             = pk(x.77)
       k     = k.45
       k_proof
             = k_proof.46
       z     = verify(k_proof.46, <'REGISTER', ~I.40, k.45, ~admin.41>,
                      k.45)
       z.1   = true
    
    3. ~I    = ~I.43
       ~admin
             = ~admin.44
       a_proof
             = sign(sign(<'REGISTER', ~I.43, pk(x.82), ~admin.44>, x.82), x.83)
       admin_pk
             = pk(x.83)
       k     = pk(x.82)
       k_proof
             = sign(<'REGISTER', ~I.43, pk(x.82), ~admin.44>, x.82)
       z     = true
       z.1   = true
    
    4. ~I    = ~I.44
       ~admin
             = ~admin.45
       a_proof
             = a_proof.47
       admin_pk
             = admin_pk.48
       k     = pk(x.85)
       k_proof
             = sign(<'REGISTER', ~I.44, pk(x.85), ~admin.45>, x.85)
       z     = true
       z.1   = verify(a_proof.47,
                      sign(<'REGISTER', ~I.44, pk(x.85), ~admin.45>, x.85), admin_pk.48)
  */

rule (modulo E) Client_register_2:
   [
   ClientState( $S, ~I, %local, <'registering', ~k> ), !Pk( $S, pkS ),
   In( <<'REG_SUCCESS', h(~I)>, sig> )
   ]
  --[
  Eq( verify(sig, <'REG_SUCCESS', h(~I)>, pkS), true ),
  SessionKey( $S, ~I, ~k ), Registered( $S, ~I, ~k ),
  Cycle( ~I, %1, ~k ), Commit( $S, ~I, pk(~k) )
  ]->
   [
   Cycle( ~I, %1, ~k ), !ClientKey( ~I, ~k ),
   ClientState( $S, ~I, %local, <'registered', ~k> )
   ]

  /*
  rule (modulo AC) Client_register_2:
     [
     ClientState( $S, ~I, %local, <'registering', ~k> ), !Pk( $S, pkS ),
     In( <<'REG_SUCCESS', h(~I)>, sig> )
     ]
    --[
    Eq( z, true ), SessionKey( $S, ~I, ~k ), Registered( $S, ~I, ~k ),
    Cycle( ~I, %1, ~k ), Commit( $S, ~I, pk(~k) )
    ]->
     [
     Cycle( ~I, %1, ~k ), !ClientKey( ~I, ~k ),
     ClientState( $S, ~I, %local, <'registered', ~k> )
     ]
    variants (modulo AC)
    1. ~I    = ~I.15
       pkS   = pkS.17
       sig   = sig.18
       z     = verify(sig.18, <'REG_SUCCESS', h(~I.15)>, pkS.17)
    
    2. ~I    = ~I.32
       pkS   = pk(x.61)
       sig   = sign(<'REG_SUCCESS', h(~I.32)>, x.61)
       z     = true
  */

rule (modulo E) Client_cycle_1:
   [
   Fr( ~k2 ), ClientState( $S, ~I, %local, <'registered', ~oldK> ),
   !Pk( $S, pkS )
   ]
  --[ StartedCycle( $S, ~I, ~oldK ), OwnsKey( ~I, ~k2 ) ]->
   [
   ClientState( $S, ~I, %local, <'cycling', ~k2, ~oldK> ),
   Out( <<'CYCLE', ~I, pk(~k2)>, sign(<'CYCLE', ~I, pk(~k2)>, ~k2), 
         sign(sign(<'CYCLE', ~I, pk(~k2)>, ~k2), ~oldK)>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Serv_cycle_1:
   [
   !Ltk( $S, ~ltkS ),
   SClientRecord( $S, ~I, current_pk, %client_time, 'init' ),
   In( <<'CYCLE', ~I, k>, n_proof, o_proof> )
   ]
  --[
  Eq( verify(n_proof, <'CYCLE', ~I, k>, k), true ),
  Eq( verify(o_proof, n_proof, current_pk), true ),
  AnswerCycleRequest( $S, ~I, k, current_pk ),
  InvalidKey( current_pk ), CycleOccured( $S, ~I ),
  ServerSessionKey( $S, ~I, k ),
  InvalidateServerSessionKey( $S, ~I, current_pk )
  ]->
   [
   SClientRecord( $S, ~I, k, %1, 'cycled' ),
   Out( <<'CYCLE_OK', h(<~I, k>)>, 
         sign(<'CYCLE_OK', h(<~I, k>)>, ~ltkS)>
   )
   ]

  /*
  rule (modulo AC) Serv_cycle_1:
     [
     !Ltk( $S, ~ltkS ),
     SClientRecord( $S, ~I, current_pk, %client_time, 'init' ),
     In( <<'CYCLE', ~I, k>, n_proof, o_proof> )
     ]
    --[
    Eq( z, true ), Eq( z.1, true ),
    AnswerCycleRequest( $S, ~I, k, current_pk ),
    InvalidKey( current_pk ), CycleOccured( $S, ~I ),
    ServerSessionKey( $S, ~I, k ),
    InvalidateServerSessionKey( $S, ~I, current_pk )
    ]->
     [
     SClientRecord( $S, ~I, k, %1, 'cycled' ),
     Out( <<'CYCLE_OK', h(<~I, k>)>, 
           sign(<'CYCLE_OK', h(<~I, k>)>, ~ltkS)>
     )
     ]
    variants (modulo AC)
    1. ~I    = ~I.21
       current_pk
             = current_pk.23
       k     = k.24
       n_proof
             = n_proof.25
       o_proof
             = o_proof.26
       z     = verify(n_proof.25, <'CYCLE', ~I.21, k.24>, k.24)
       z.1   = verify(o_proof.26, n_proof.25, current_pk.23)
    
    2. ~I    = ~I.55
       current_pk
             = pk(x.107)
       k     = k.58
       n_proof
             = n_proof.59
       o_proof
             = sign(n_proof.59, x.107)
       z     = verify(n_proof.59, <'CYCLE', ~I.55, k.58>, k.58)
       z.1   = true
    
    3. ~I    = ~I.58
       current_pk
             = current_pk.60
       k     = pk(x.113)
       n_proof
             = sign(<'CYCLE', ~I.58, pk(x.113)>, x.113)
       o_proof
             = o_proof.63
       z     = true
       z.1   = verify(o_proof.63,
                      sign(<'CYCLE', ~I.58, pk(x.113)>, x.113), current_pk.60)
    
    4. ~I    = ~I.58
       current_pk
             = pk(x.112)
       k     = pk(x.113)
       n_proof
             = sign(<'CYCLE', ~I.58, pk(x.113)>, x.113)
       o_proof
             = sign(sign(<'CYCLE', ~I.58, pk(x.113)>, x.113), x.112)
       z     = true
       z.1   = true
  */

rule (modulo E) Deregister_with_server:
   [ SClientRecord( $S, ~I, k, %time, state ) ]
  --[ Deregistered( $S, ~I ) ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Client_cycle_2:
   [
   ClientState( $S, ~I, %local, <'cycling', ~k, ~oldK> ),
   !Pk( $S, pkS ), Cycle( ~I, %count, ~oldK ),
   In( <<'CYCLE_OK', h(<~I, pk(~k)>)>, sig> )
   ]
  --[
  Eq( verify(sig, <'CYCLE_OK', h(<~I, pk(~k)>)>, pkS), true ),
  SessionKeyRhangeover( $S, ~I, ~k, ~oldK ),
  SessionKey( $S, ~I, ~k ), Cycle( ~I, (%count%+%1), ~k ),
  InvalidateKey( ~I, ~oldK ), OnlyOnce( <'CLY_CYCLE_LIM', ~I> )
  ]->
   [
   Cycle( ~I, (%count%+%1), ~k ), !ClientKey( ~I, ~k ),
   ClientState( $S, ~I, %1, <'cycled', ~k> )
   ]

  // loop breaker: [2]
  /*
  rule (modulo AC) Client_cycle_2:
     [
     ClientState( $S, ~I, %local, <'cycling', ~k, ~oldK> ),
     !Pk( $S, pkS ), Cycle( ~I, %count, ~oldK ),
     In( <<'CYCLE_OK', h(<~I, pk(~k)>)>, sig> )
     ]
    --[
    Eq( z, true ), SessionKeyRhangeover( $S, ~I, ~k, ~oldK ),
    SessionKey( $S, ~I, ~k ), Cycle( ~I, (%count%+%1), ~k ),
    InvalidateKey( ~I, ~oldK ), OnlyOnce( <'CLY_CYCLE_LIM', ~I> )
    ]->
     [
     Cycle( ~I, (%count%+%1), ~k ), !ClientKey( ~I, ~k ),
     ClientState( $S, ~I, %1, <'cycled', ~k> )
     ]
    variants (modulo AC)
    1. ~I    = ~I.18
       ~k    = ~k.19
       pkS   = pkS.21
       sig   = sig.22
       z     = verify(sig.22, <'CYCLE_OK', h(<~I.18, pk(~k.19)>)>, pkS.21)
    
    2. ~I    = ~I.53
       ~k    = ~k.54
       pkS   = pk(x.103)
       sig   = sign(<'CYCLE_OK', h(<~I.53, pk(~k.54)>)>, x.103)
       z     = true
    // loop breaker: [2]
  */

rule (modulo E) Client_tok_init:
   [
   Fr( ~time ), Fr( ~payload ), Fr( ~dk ),
   ClientState( $S, ~I, %local, <ready_state, ~k> ), !Pk( $S, pkS )
   ]
  --[
  MadeTokenRequest( $S, ~I, <$p1, $p2, ~I, %local, $perms, ~payload>
  )
  ]->
   [
   ClientState( $S, ~I, %local,
                <'tok_wait', <$p1, $p2, ~I, %local, $perms, ~payload>, ~k, ~dk>
   ),
   Out( <
         <'STAMP', <$p1, $p2, ~I, %local, $perms, ~payload>, kempk($G, ~dk)
         >, 
         sign(<'STAMP', <$p1, $p2, ~I, %local, $perms, ~payload>, 
               kempk($G, ~dk)>,
              ~k)
        >
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Server_tok:
   [
   SClientRecord( $S, ~I, k, %client_time, validstate ),
   !Ltk( $S, ~ltkS ), Fr( ~newpayload ), Fr( ~ss ),
   In( <
        <'STAMP', <$p1, $p2, ~I, %client_time, $perms, ~payload>, ek>, sig>
   )
   ]
  --[
  Eq( verify(sig,
             <'STAMP', <$p1, $p2, ~I, %client_time, $perms, ~payload>, ek>, k),
      true
  ),
  TokenApproved( $S, ~I, <$p1, $p2, ~I, %client_time, $perms, ~ss>,
                 <$p1, $p2, ~I, %client_time, $perms, ~payload>
  ),
  TokenRunning( $S, ~I, <$p1, $p2, ~I, %client_time, $perms, ~ss> )
  ]->
   [
   ValidToken( $S, h(<$p1, $p2, ~I, %client_time, $perms, ~ss>),
               'active'
   ),
   !GlobalToken( $S, <$p1, $p2, ~I, %client_time, $perms, ~ss> ),
   Out( h(<$p1, $p2, ~I, %client_time, $perms, ~ss>) ),
   SClientRecord( $S, ~I, k, (%client_time%+%1),
                  <'ready', h(<$p1, $p2, ~I, %client_time, $perms, ~ss>)>
   ),
   Out( <
         <'STAMPED', 
          h(<<$p1, $p2, ~I, %client_time, $perms, ~ss>, $p1, $p2, ~I, 
             %client_time, $perms, ~payload>), 
          kemencaps($G, ~ss, ek)>, 
         sign(<'STAMPED', 
               h(<<$p1, $p2, ~I, %client_time, $perms, ~ss>, $p1, $p2, ~I, 
                  %client_time, $perms, ~payload>), 
               kemencaps($G, ~ss, ek)>,
              ~ltkS)
        >
   )
   ]

  // loop breaker: [0]
  /*
  rule (modulo AC) Server_tok:
     [
     SClientRecord( $S, ~I, k, %client_time, validstate ),
     !Ltk( $S, ~ltkS ), Fr( ~newpayload ), Fr( ~ss ),
     In( <
          <'STAMP', <$p1, $p2, ~I, %client_time, $perms, ~payload>, ek>, sig>
     )
     ]
    --[
    Eq( z, true ),
    TokenApproved( $S, ~I, <$p1, $p2, ~I, %client_time, $perms, ~ss>,
                   <$p1, $p2, ~I, %client_time, $perms, ~payload>
    ),
    TokenRunning( $S, ~I, <$p1, $p2, ~I, %client_time, $perms, ~ss> )
    ]->
     [
     ValidToken( $S, h(<$p1, $p2, ~I, %client_time, $perms, ~ss>),
                 'active'
     ),
     !GlobalToken( $S, <$p1, $p2, ~I, %client_time, $perms, ~ss> ),
     Out( h(<$p1, $p2, ~I, %client_time, $perms, ~ss>) ),
     SClientRecord( $S, ~I, k, (%client_time%+%1),
                    <'ready', h(<$p1, $p2, ~I, %client_time, $perms, ~ss>)>
     ),
     Out( <
           <'STAMPED', 
            h(<<$p1, $p2, ~I, %client_time, $perms, ~ss>, $p1, $p2, ~I, 
               %client_time, $perms, ~payload>), 
            kemencaps($G, ~ss, ek)>, 
           sign(<'STAMPED', 
                 h(<<$p1, $p2, ~I, %client_time, $perms, ~ss>, $p1, $p2, ~I, 
                    %client_time, $perms, ~payload>), 
                 kemencaps($G, ~ss, ek)>,
                ~ltkS)
          >
     )
     ]
    variants (modulo AC)
    1. $p1   = $p1.34
       $p2   = $p2.35
       $perms
             = $perms.36
       ~I    = ~I.37
       ~payload
             = ~payload.40
       ek    = ek.42
       k     = k.43
       sig   = sig.44
       z     = verify(sig.44,
                      <'STAMP', 
                       <$p1.34, $p2.35, ~I.37, %client_time.46, $perms.36, ~payload.40>, 
                       ek.42>,
                      k.43)
       %client_time
             = %client_time.46
    
    2. $p1   = $p1.85
       $p2   = $p2.86
       $perms
             = $perms.87
       ~I    = ~I.88
       ~payload
             = ~payload.91
       ek    = ek.93
       k     = pk(x.166)
       sig   = sign(<'STAMP', 
                     <$p1.85, $p2.86, ~I.88, %client_time.97, $perms.87, ~payload.91>, 
                     ek.93>,
                    x.166)
       z     = true
       %client_time
             = %client_time.97
    // loop breaker: [0]
  */

rule (modulo E) Client_tok_2:
   [
   ClientState( $S, ~I, %local,
                <'tok_wait', <$p1, $p2, ~I, %local, $perms, ~payload>, ~k, ~dk>
   ),
   !Pk( $S, pkS ),
   In( <
        <'STAMPED', 
         h(<<$p1, $p2, ~I, %local, $perms, kemdecaps($G, ct, ~dk)>, $p1, 
            $p2, ~I, %local, $perms, ~payload>), 
         ct>, 
        sig>
   )
   ]
  --[
  Eq( verify(sig,
             <'STAMPED', 
              h(<<$p1, $p2, ~I, %local, $perms, kemdecaps($G, ct, ~dk)>, $p1, 
                 $p2, ~I, %local, $perms, ~payload>), 
              ct>,
             pkS),
      true
  ),
  HasToken( $S, ~I,
            <$p1, $p2, ~I, %local, $perms, kemdecaps($G, ct, ~dk)>
  ),
  TokenCommit( $S, ~I,
               <$p1, $p2, ~I, %local, $perms, kemdecaps($G, ct, ~dk)>
  )
  ]->
   [
   ClientState( $S, ~I, (%local%+%1),
                <'ready', <$p1, $p2, ~I, %local, $perms, kemdecaps($G, ct, ~dk)>, 
                 ~k>
   )
   ]

  /*
  rule (modulo AC) Client_tok_2:
     [
     ClientState( $S, ~I, %local,
                  <'tok_wait', <$p1, $p2, ~I, %local, $perms, ~payload>, ~k, ~dk>
     ),
     !Pk( $S, pkS ),
     In( <
          <'STAMPED', 
           h(<<$p1, $p2, ~I, %local, $perms, z>, $p1, $p2, ~I, %local, 
              $perms, ~payload>), 
           ct>, 
          sig>
     )
     ]
    --[
    Eq( z.1, true ),
    HasToken( $S, ~I, <$p1, $p2, ~I, %local, $perms, z> ),
    TokenCommit( $S, ~I, <$p1, $p2, ~I, %local, $perms, z> )
    ]->
     [
     ClientState( $S, ~I, (%local%+%1),
                  <'ready', <$p1, $p2, ~I, %local, $perms, z>, ~k>
     )
     ]
    variants (modulo AC)
    1. $p1   = $p1.52
       $p2   = $p2.53
       $perms
             = $perms.54
       ~I    = ~I.55
       ~dk   = ~dk.56
       ~payload
             = ~payload.58
       ct    = ct.59
       pkS   = pkS.60
       sig   = sig.61
       z     = kemdecaps($G.100, ct.59, ~dk.56)
       %local
             = %local.62
       z.1   = verify(sig.61,
                      <'STAMPED', 
                       h(<
                          <$p1.52, $p2.53, ~I.55, %local.62, $perms.54, 
                           kemdecaps($G.100, ct.59, ~dk.56)>, 
                          $p1.52, $p2.53, ~I.55, %local.62, $perms.54, ~payload.58>), 
                       ct.59>,
                      pkS.60)
    
    2. $p1   = $p1.52
       $p2   = $p2.53
       $perms
             = $perms.54
       ~I    = ~I.55
       ~dk   = ~dk.56
       ~payload
             = ~payload.58
       ct    = kemencaps($x.100, z.65, kempk($x.100, ~dk.56))
       pkS   = pkS.60
       sig   = sig.61
       z     = z.65
       %local
             = %local.62
       z.1   = verify(sig.61,
                      <'STAMPED', 
                       h(<<$p1.52, $p2.53, ~I.55, %local.62, $perms.54, z.65>, $p1.52, 
                          $p2.53, ~I.55, %local.62, $perms.54, ~payload.58>), 
                       kemencaps($x.100, z.65, kempk($x.100, ~dk.56))>,
                      pkS.60)
    
    3. $p1   = $p1.62
       $p2   = $p2.63
       $perms
             = $perms.64
       ~I    = ~I.65
       ~dk   = ~dk.66
       ~payload
             = ~payload.68
       ct    = ct.69
       pkS   = pk(x.120)
       sig   = sign(<'STAMPED', 
                     h(<
                        <$p1.62, $p2.63, ~I.65, %local.72, $perms.64, 
                         kemdecaps($x.110, ct.69, ~dk.66)>, 
                        $p1.62, $p2.63, ~I.65, %local.72, $perms.64, ~payload.68>), 
                     ct.69>,
                    x.120)
       z     = kemdecaps($x.110, ct.69, ~dk.66)
       %local
             = %local.72
       z.1   = true
    
    4. $p1   = $p1.62
       $p2   = $p2.63
       $perms
             = $perms.64
       ~I    = ~I.65
       ~dk   = ~dk.66
       ~payload
             = ~payload.68
       ct    = kemencaps($x.110, z.75, kempk($x.110, ~dk.66))
       pkS   = pk(x.120)
       sig   = sign(<'STAMPED', 
                     h(<<$p1.62, $p2.63, ~I.65, %local.72, $perms.64, z.75>, $p1.62, 
                        $p2.63, ~I.65, %local.72, $perms.64, ~payload.68>), 
                     kemencaps($x.110, z.75, kempk($x.110, ~dk.66))>,
                    x.120)
       z     = z.75
       %local
             = %local.72
       z.1   = true
  */

rule (modulo E) Expire_token:
   [ ValidToken( $S, tok, 'active' ) ]
  --[ ExpireToken( $S, tok ) ]->
   [ ValidToken( $S, tok, 'expired' ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Revoke_token:
   [ ValidToken( $S, tok, 'active' ) ]
  --[ RevokedToken( $S, tok ) ]->
   [ ValidToken( $S, tok, 'revoked' ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ServerVerify:
   [ ValidToken( $S, tokenHash, 'active' ) ]
  --[ VerifiesToken( $S, tokenHash ) ]->
   [ ValidToken( $S, tokenHash, 'verified' ) ]

  /* has exactly the trivial AC variant */

lemma Exists_verification_trace:
  exists-trace
  "∃ S I t #i #j.
    ((((HasToken( S, I, t ) @ #i) ∧ (VerifiesToken( S, h(t) ) @ #j)) ∧
      (#i < #j)) ∧
     (¬(∃ #r. LtkReveal( S ) @ #r))) ∧
    (¬(∃ #r. LtkReveal( I ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
"∃ S I t #i #j.
  (HasToken( S, I, t ) @ #i) ∧ (VerifiesToken( S, h(t) ) @ #j)
 ∧
  (#i < #j) ∧
  (∀ #r. (LtkReveal( S ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (LtkReveal( I ) @ #r) ⇒ ⊥)"
*/
simplify
solve( ClientState( $S, ~I, %local,
                    <'tok_wait', <$p1, $p2, ~I, %local, $perms, ~payload>, ~k, ~dk>
       ) ▶₀ #i )
  case Client_tok_init_case_1
  solve( ValidToken( $S, h(<$p1, $p2, ~I, %1, $perms, z>), 'active'
         ) ▶₀ #j )
    case Server_tok
    solve( !KU( sign(<'STAMPED', 
                      h(<<$p1, $p2, ~I, %1, $perms, ~ss>, $p1, $p2, ~I, %1, $perms, 
                         ~payload>), 
                      kemencaps($x.1, ~ss, kempk($x.1, ~dk))>,
                     x)
           ) @ #vk.6 )
      case Server_tok
      solve( !KU( sign(<'STAMP', <$p1, $p2, ~I, %1, $perms, ~payload>, 
                        kempk($G, ~dk)>,
                       x)
             ) @ #vk.23 )
        case Client_tok_init
        solve( SClientRecord( $S, ~I, pk(~k), %1, validstate ) ▶₀ #vr.5 )
          case Serv_cycle_1
          solve( !Pk( $S, pk(~ltkS) ) ▶₁ #i )
            case Register_pk
            solve( !KU( ~admin.1 ) @ #vk.38 )
              case Client_register_1
              solve( !KU( sign(<'CYCLE', ~I, pk(~k)>, ~k) ) @ #vk.34 )
                case c_sign
                by solve( !KU( ~k ) @ #vk.42 )
              qed
            qed
          qed
        next
          case Server_register
          solve( !KU( sign(<'REGISTER', ~I, pk(~k), ~admin.1>, ~k)
                 ) @ #vk.32 )
            case Client_register_1
            solve( !KU( ~admin ) @ #vk.31 )
              case Client_register_1
              solve( !KU( sign(sign(<'REGISTER', ~I, pk(~k), ~admin>, ~k),
                               ~admin_k)
                     ) @ #vk.33 )
                case Client_register_1
                solve( !KU( h(<<$p1, $p2, ~I, %1, $perms, ~ss>, $p1, $p2, ~I, %1, 
                               $perms, ~payload>)
                       ) @ #vk.13 )
                  case Server_tok
                  solve( !KU( kemencaps($G, ~ss, kempk($G, ~dk)) ) @ #vk.15 )
                    case Server_tok
                    solve( !KU( kempk($G, ~dk) ) @ #vk.31 )
                      case Client_tok_init
                      solve( !KU( ~payload ) @ #vk.31 )
                        case Client_tok_init
                        solve( !KU( ~I ) @ #vk.27 )
                          case Client_register_1
                          solve( !Pk( $S, pk(~ltkS) ) ▶₁ #i )
                            case Register_pk
                            solve( !KU( pk(~k) ) @ #vk.33 )
                              case Client_register_1
                              SOLVED // trace found
                            next
                              case c_pk
                              by sorry
                            qed
                          qed
                        next
                          case Client_tok_init
                          by sorry
                        qed
                      qed
                    next
                      case c_kempk
                      by sorry
                    qed
                  next
                    case c_kemencaps
                    by sorry
                  qed
                next
                  case c_h
                  by sorry
                qed
              next
                case c_sign
                by sorry
              qed
            qed
          next
            case c_sign
            by sorry
          qed
        qed
      next
        case c_sign
        by sorry
      qed
    next
      case c_sign
      by sorry
    qed
  qed
next
  case Client_tok_init_case_2
  by sorry
next
  case Client_tok_init_case_3
  by sorry
qed

lemma Exists_verification_trace_post_cycle:
  exists-trace
  "∃ S I t #b #i #j.
    ((((((CycleOccured( S, I ) @ #b) ∧ (HasToken( S, I, t ) @ #i)) ∧
        (VerifiesToken( S, h(t) ) @ #j)) ∧
       (#b < #i)) ∧
      (#i < #j)) ∧
     (¬(∃ #r. LtkReveal( S ) @ #r))) ∧
    (¬(∃ #r. LtkReveal( I ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
"∃ S I t #b #i #j.
  (CycleOccured( S, I ) @ #b) ∧
  (HasToken( S, I, t ) @ #i) ∧
  (VerifiesToken( S, h(t) ) @ #j)
 ∧
  (#b < #i) ∧
  (#i < #j) ∧
  (∀ #r. (LtkReveal( S ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (LtkReveal( I ) @ #r) ⇒ ⊥)"
*/
simplify
solve( !Ltk( $S, ~ltkS ) ▶₀ #b )
  case Register_pk
  solve( SClientRecord( $S, ~I, pk(x), %client_time, 'init' ) ▶₁ #b )
    case Server_register
    solve( ClientState( $S, ~I, %local,
                        <'tok_wait', <$p1, $p2, ~I, %local, $perms, ~payload>, ~k, ~dk>
           ) ▶₀ #i )
      case Client_tok_init_case_1
      solve( !Pk( $S, pk(x.2) ) ▶₁ #i )
        case Register_pk
        solve( ValidToken( $S, h(<$p1, $p2, ~I, %1, $perms, z>), 'active'
               ) ▶₀ #j )
          case Server_tok
          solve( !KU( ~admin ) @ #vk.23 )
            case Client_register_1
            solve( !KU( sign(<'CYCLE', ~I, pk(x.1)>, x.1) ) @ #vk.13 )
              case c_sign
              solve( !KU( sign(sign(<'CYCLE', ~I, pk(x.1)>, x.1), x) ) @ #vk.16 )
                case c_sign
                solve( !KU( sign(<'STAMPED', 
                                  h(<<$p1, $p2, ~I, %1, $perms, ~ss>, $p1, $p2, ~I, %1, $perms, 
                                     ~payload>), 
                                  kemencaps($x.2, ~ss, kempk($x.2, ~dk))>,
                                 ~ltk)
                       ) @ #vk.24 )
                  case Server_tok
                  solve( !KU( sign(sign(<'REGISTER', ~I, pk(x), ~admin>, x), ~k.2)
                         ) @ #vk.30 )
                    case Client_register_1
                    by sorry
                  next
                    case c_sign
                    by sorry
                  qed
                next
                  case c_sign
                  by sorry
                qed
              qed
            qed
          qed
        qed
      qed
    next
      case Client_tok_init_case_2
      solve( ValidToken( $S, h(<$p1, $p2, ~I, %1, $perms, z>), 'active'
             ) ▶₀ #j )
        case Server_tok
        solve( !KU( sign(<'CYCLE', ~I, pk(x.1)>, x.1) ) @ #vk.11 )
          case c_sign
          solve( !KU( sign(sign(<'CYCLE', ~I, pk(x.1)>, x.1), x) ) @ #vk.13 )
            case c_sign
            solve( !KU( sign(<'STAMPED', 
                              h(<<$p1, $p2, ~I, %1, $perms, ~ss>, $p1, $p2, ~I, %1, $perms, 
                                 ~payload>), 
                              kemencaps($x.3, ~ss, kempk($x.3, ~dk))>,
                             x.2)
                   ) @ #vk.21 )
              case Server_tok
              solve( !KU( sign(sign(<'REGISTER', ~I, pk(x), ~admin>, x), ~k.1)
                     ) @ #vk.29 )
                case Client_register_1
                by sorry
              next
                case c_sign
                by sorry
              qed
            next
              case c_sign
              solve( !KU( sign(<'REGISTER', ~I, pk(x), ~admin>, x) ) @ #vk.28 )
                case Client_register_1
                solve( !KU( sign(<'REG_SUCCESS', h(~I)>, ~ltk.1) ) @ #vk.35 )
                  case Server_register
                  by sorry
                next
                  case c_sign
                  by sorry
                qed
              next
                case c_sign
                solve( !KU( sign(sign(<'REGISTER', ~I, pk(x), ~admin>, x), ~k.1)
                       ) @ #vk.30 )
                  case Client_register_1
                  by sorry
                next
                  case c_sign
                  solve( !KU( sign(<'REG_SUCCESS', h(~I)>, ~ltk.1) ) @ #vk.36 )
                    case Server_register
                    by sorry
                  next
                    case c_sign
                    by sorry
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    next
      case Client_tok_init_case_3
      solve( ValidToken( $S, h(<$p1, $p2, ~I, %1, $perms, z>), 'active'
             ) ▶₀ #j )
        case Server_tok
        solve( !KU( sign(<'CYCLE', ~I, pk(x.1)>, x.1) ) @ #vk.11 )
          case Client_cycle_1
          solve( !KU( sign(sign(<'CYCLE', ~I, pk(~k)>, ~k), x) ) @ #vk.13 )
            case Client_cycle_1
            solve( !KU( sign(<'STAMPED', 
                              h(<<$p1, $p2, ~I, %1, $perms, ~ss>, $p1, $p2, ~I, %1, $perms, 
                                 ~payload>), 
                              kemencaps($x.1, ~ss, kempk($x.1, ~dk))>,
                             x)
                   ) @ #vk.21 )
              case Server_tok
              solve( !KU( sign(<'REGISTER', ~I, pk(~oldK), ~admin>, ~oldK)
                     ) @ #vk.28 )
                case Client_register_1
                solve( !KU( sign(<'CYCLE_OK', h(<~I, pk(~k)>)>, ~ltk.1)
                       ) @ #vk.35 )
                  case Serv_cycle_1
                  solve( !KU( sign(<'REG_SUCCESS', h(~I)>, ~ltk.2) ) @ #vk.41 )
                    case Server_register
                    solve( !KU( sign(<'STAMP', <$p1, $p2, ~I, %1, $perms, ~payload>, 
                                      kempk($G, ~dk)>,
                                     x)
                           ) @ #vk.51 )
                      case Client_tok_init
                      solve( Cycle( ~I, %count, ~oldK ) ▶₂ #vr.5 )
                        case Client_register_2
                        solve( SClientRecord( $S, ~I, pk(~k), %1, validstate ) ▶₀ #vr.12 )
                          case Serv_cycle_1
                          solve( !KU( ~I ) @ #vk.18 )
                            case Client_cycle_1
                            by contradiction /* cyclic */
                          next
                            case Client_register_1
                            solve( !KU( ~admin ) @ #vk.35 )
                              case Client_register_1
                              solve( !KU( ~payload ) @ #vk.50 )
                                case Client_tok_init
                                solve( !KU( sign(sign(<'REGISTER', ~I, pk(~oldK), ~admin>, ~oldK),
                                                 ~admin_k)
                                       ) @ #vk.37 )
                                  case Client_register_1
                                  solve( !KU( h(<<$p1, $p2, ~I, %1, $perms, ~ss>, $p1, $p2, ~I, %1, 
                                                 $perms, ~payload>)
                                         ) @ #vk.35 )
                                    case Server_tok
                                    solve( !KU( pk(~k) ) @ #vk.33 )
                                      case Client_cycle_1
                                      solve( !KU( pk(~oldK) ) @ #vk.39 )
                                        case Client_register_1
                                        solve( !Pk( $S, pk(~ltkS.1) ) ▶₁ #i )
                                          case Register_pk
                                          solve( !KU( h(<~I, pk(~k)>) ) @ #vk.42 )
                                            case Serv_cycle_1
                                            solve( !KU( h(~I) ) @ #vk.45 )
                                              case Server_register
                                              solve( !KU( kemencaps($G, ~ss, kempk($G, ~dk))
                                                     ) @ #vk.41 )
                                                case Server_tok
                                                solve( !KU( kempk($G, ~dk) ) @ #vk.51 )
                                                  case Client_tok_init
                                                  SOLVED // trace found
                                                next
                                                  case c_kempk
                                                  by sorry
                                                qed
                                              next
                                                case c_kemencaps
                                                by sorry
                                              qed
                                            next
                                              case c_h
                                              by sorry
                                            qed
                                          next
                                            case c_h
                                            by sorry
                                          qed
                                        qed
                                      next
                                        case c_pk
                                        by sorry
                                      qed
                                    next
                                      case c_pk
                                      by sorry
                                    qed
                                  next
                                    case c_h
                                    by sorry
                                  qed
                                next
                                  case c_sign
                                  by sorry
                                qed
                              qed
                            qed
                          next
                            case Client_tok_init
                            by contradiction /* cyclic */
                          qed
                        qed
                      qed
                    next
                      case c_sign
                      by sorry
                    qed
                  next
                    case c_sign
                    by sorry
                  qed
                next
                  case c_sign
                  by sorry
                qed
              next
                case c_sign
                by sorry
              qed
            next
              case c_sign
              by sorry
            qed
          next
            case c_sign
            by sorry
          qed
        next
          case c_sign
          by sorry
        qed
      qed
    qed
  qed
qed

lemma InjectiveKeyAgreement [reuse]:
  all-traces
  "∀ S I k #i.
    (((Commit( S, I, k ) @ #i) ∧ (¬(∃ #r. LtkReveal( S ) @ #r))) ∧
     (¬(∃ #r. LtkReveal( I ) @ #r))) ⇒
    ((∃ #j. (Running( S, I, k ) @ #j) ∧ (#j < #i)) ∧
     (¬(∃ S2 I2 #i2. (Commit( S2, I2, k ) @ #i2) ∧ (¬(#i = #i2)))))"
/*
guarded formula characterizing all counter-examples:
"∃ S I k #i.
  (Commit( S, I, k ) @ #i)
 ∧
  (∀ #r. (LtkReveal( S ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (LtkReveal( I ) @ #r) ⇒ ⊥) ∧
  (((∀ #j. (Running( S, I, k ) @ #j) ⇒ ¬(#j < #i)) ∨
    (∃ S2 I2 #i2. (Commit( S2, I2, k ) @ #i2) ∧ ¬(#i = #i2))))"
*/
simplify
solve( (∀ #j. (Running( $S, ~I, pk(~k) ) @ #j) ⇒ ¬(#j < #i))  ∥
       (∃ S2 I2 #i2. (Commit( S2, I2, pk(~k) ) @ #i2) ∧ ¬(#i = #i2)) )
  case case_1
  solve( ClientState( $S, ~I, %local, <'registering', ~k> ) ▶₀ #i )
    case Client_register_1
    solve( !Pk( $S, pk(x) ) ▶₁ #i )
      case Register_pk
      solve( !KU( sign(<'REG_SUCCESS', h(~I)>, ~ltk) ) @ #vk.4 )
        case Server_register
        solve( !KU( ~admin.1 ) @ #vk.12 )
          case Client_register_1
          solve( !KU( sign(<'REGISTER', ~I, pk(x), ~admin.1>, x) ) @ #vk.14 )
            case Client_register_1
            by contradiction /* from formulas */
          next
            case c_sign
            solve( !KU( sign(sign(<'REGISTER', ~I, pk(x), ~admin.1>, x), ~k.2)
                   ) @ #vk.15 )
              case Client_register_1
              by contradiction /* from formulas */
            next
              case c_sign
              by solve( !KU( ~k.2 ) @ #vk.17 )
            qed
          qed
        qed
      next
        case c_sign
        solve( !KU( ~ltk ) @ #vk.5 )
          case Reveal_ltk
          by contradiction /* from formulas */
        qed
      qed
    qed
  qed
next
  case case_2
  solve( (#i < #i2)  ∥ (#i2 < #i) )
    case case_1
    solve( ClientState( $S, ~I, %local, <'registering', ~k> ) ▶₀ #i )
      case Client_register_1
      solve( !Pk( $S, pk(x) ) ▶₁ #i )
        case Register_pk
        solve( ClientState( $S.1, ~I.1, %local, <'registering', ~k>
               ) ▶₀ #i2 )
          case Client_register_1
          by contradiction /* cyclic */
        qed
      qed
    qed
  next
    case case_2
    solve( ClientState( $S, ~I, %local, <'registering', ~k> ) ▶₀ #i )
      case Client_register_1
      solve( !Pk( $S, pk(x) ) ▶₁ #i )
        case Register_pk
        solve( ClientState( $S.1, ~I.1, %local, <'registering', ~k>
               ) ▶₀ #i2 )
          case Client_register_1
          by contradiction /* cyclic */
        qed
      qed
    qed
  qed
qed

lemma InjectiveTokenAgreement [reuse]:
  all-traces
  "∀ S I t #i.
    (((TokenCommit( S, I, t ) @ #i) ∧ (¬(∃ #r. LtkReveal( S ) @ #r))) ∧
     (¬(∃ #r. LtkReveal( I ) @ #r))) ⇒
    ((∃ #j. (TokenRunning( S, I, t ) @ #j) ∧ (#j < #i)) ∧
     (¬(∃ S2 I2 #i2. (Commit( S2, I2, t ) @ #i2) ∧ (¬(#i = #i2)))))"
/*
guarded formula characterizing all counter-examples:
"∃ S I t #i.
  (TokenCommit( S, I, t ) @ #i)
 ∧
  (∀ #r. (LtkReveal( S ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (LtkReveal( I ) @ #r) ⇒ ⊥) ∧
  (((∀ #j. (TokenRunning( S, I, t ) @ #j) ⇒ ¬(#j < #i)) ∨
    (∃ S2 I2 #i2. (Commit( S2, I2, t ) @ #i2) ∧ ¬(#i = #i2))))"
*/
simplify
solve( (∀ #j.
         (TokenRunning( $S, ~I, <$p1, $p2, ~I, %local, $perms, z> ) @ #j)
        ⇒
         ¬(#j < #i))  ∥
       (∃ S2 I2 #i2.
         (Commit( S2, I2, <$p1, $p2, ~I, %local, $perms, z> ) @ #i2)
        ∧
         ¬(#i = #i2)) )
  case case_1
  solve( ClientState( $S, ~I, %local,
                      <'tok_wait', <$p1, $p2, ~I, %local, $perms, ~payload>, ~k, ~dk>
         ) ▶₀ #i )
    case Client_tok_init_case_1
    solve( !Pk( $S, pk(x) ) ▶₁ #i )
      case Register_pk
      solve( splitEqs(0) )
        case split_case_1
        solve( !KU( sign(<'STAMPED', 
                          h(<<$p1, $p2, ~I, %1, $perms, kemdecaps($x, ct, ~dk)>, $p1, $p2, 
                             ~I, %1, $perms, ~payload>), 
                          ct>,
                         ~ltk)
               ) @ #vk.6 )
          case c_sign
          solve( !KU( ~ltk ) @ #vk.7 )
            case Reveal_ltk
            by contradiction /* from formulas */
          qed
        qed
      next
        case split_case_2
        solve( !KU( sign(<'STAMPED', 
                          h(<<$p1, $p2, ~I, %1, $perms, z>, $p1, $p2, ~I, %1, $perms, 
                             ~payload>), 
                          kemencaps($x, z, kempk($x, ~dk))>,
                         ~ltk)
               ) @ #vk.6 )
          case Server_tok
          by contradiction /* from formulas */
        next
          case c_sign
          solve( !KU( ~ltk ) @ #vk.7 )
            case Reveal_ltk
            by contradiction /* from formulas */
          qed
        qed
      qed
    qed
  next
    case Client_tok_init_case_2
    solve( (∃ #r. (LtkReveal( $S ) @ #r))  ∥
           (∃ #r. (LtkReveal( ~I ) @ #r))  ∥
           ((∃ #j. (Running( $S, ~I, pk(~k) ) @ #j) ∧ #j < #vr.1) ∧
            (∀ S2 I2 #i2. (Commit( S2, I2, pk(~k) ) @ #i2) ⇒ #vr.1 = #i2)) )
      case case_1
      by contradiction /* from formulas */
    next
      case case_2
      by contradiction /* from formulas */
    next
      case case_3
      solve( !Pk( $S, pk(x) ) ▶₁ #i )
        case Register_pk
        solve( !Ltk( $S, ~ltkS ) ▶₀ #j )
          case Register_pk
          solve( !AdminPublic( $S, ~admin, pk(x) ) ▶₁ #j )
            case Register_Authorized_User
            solve( !KU( ~admin ) @ #vk.19 )
              case Client_register_1
              solve( splitEqs(0) )
                case split_case_1
                solve( !KU( sign(<'STAMPED', 
                                  h(<<$p1, $p2, ~I, %1, $perms, kemdecaps($x, ct, ~dk)>, $p1, $p2, 
                                     ~I, %1, $perms, ~payload>), 
                                  ct>,
                                 ~ltk)
                       ) @ #vk.8 )
                  case c_sign
                  solve( !KU( ~ltk ) @ #vk.23 )
                    case Reveal_ltk
                    by contradiction /* from formulas */
                  qed
                qed
              next
                case split_case_2
                solve( !KU( sign(<'STAMPED', 
                                  h(<<$p1, $p2, ~I, %1, $perms, z>, $p1, $p2, ~I, %1, $perms, 
                                     ~payload>), 
                                  kemencaps($x, z, kempk($x, ~dk))>,
                                 ~ltk)
                       ) @ #vk.8 )
                  case Server_tok
                  by contradiction /* from formulas */
                next
                  case c_sign
                  solve( !KU( ~ltk ) @ #vk.23 )
                    case Reveal_ltk
                    by contradiction /* from formulas */
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  next
    case Client_tok_init_case_3
    solve( (∃ #r. (LtkReveal( $S ) @ #r))  ∥
           (∃ #r. (LtkReveal( ~I ) @ #r))  ∥
           ((∃ #j. (Running( $S, ~I, pk(~oldK) ) @ #j) ∧ #j < #vr.5) ∧
            (∀ S2 I2 #i2. (Commit( S2, I2, pk(~oldK) ) @ #i2) ⇒ #vr.5 = #i2)) )
      case case_1
      by contradiction /* from formulas */
    next
      case case_2
      by contradiction /* from formulas */
    next
      case case_3
      solve( !Pk( $S, pk(x) ) ▶₁ #i )
        case Register_pk
        solve( !Ltk( $S, ~ltkS ) ▶₀ #j )
          case Register_pk
          solve( !AdminPublic( $S, ~admin, pk(x) ) ▶₁ #j )
            case Register_Authorized_User
            solve( !KU( ~admin ) @ #vk.24 )
              case Client_register_1
              solve( splitEqs(0) )
                case split_case_1
                solve( !KU( sign(<'STAMPED', 
                                  h(<<$p1, $p2, ~I, %1, $perms, kemdecaps($x, ct, ~dk)>, $p1, $p2, 
                                     ~I, %1, $perms, ~payload>), 
                                  ct>,
                                 ~ltk)
                       ) @ #vk.8 )
                  case c_sign
                  solve( !KU( ~ltk ) @ #vk.28 )
                    case Reveal_ltk
                    by contradiction /* from formulas */
                  qed
                qed
              next
                case split_case_2
                solve( !KU( sign(<'STAMPED', 
                                  h(<<$p1, $p2, ~I, %1, $perms, z>, $p1, $p2, ~I, %1, $perms, 
                                     ~payload>), 
                                  kemencaps($x, z, kempk($x, ~dk))>,
                                 ~ltk)
                       ) @ #vk.8 )
                  case Server_tok
                  by contradiction /* from formulas */
                next
                  case c_sign
                  solve( !KU( ~ltk ) @ #vk.28 )
                    case Reveal_ltk
                    by contradiction /* from formulas */
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma Exists_register_trace:
  exists-trace
  "∃ S I k #i.
    (Registered( S, I, k ) @ #i) ∧ (¬(∃ #r. LtkReveal( S ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
"∃ S I k #i.
  (Registered( S, I, k ) @ #i) ∧ ∀ #r. (LtkReveal( S ) @ #r) ⇒ ⊥"
*/
simplify
solve( (∃ #r. (LtkReveal( $S ) @ #r))  ∥
       (∃ #r. (LtkReveal( ~I ) @ #r))  ∥
       ((∃ #j. (Running( $S, ~I, pk(~k) ) @ #j) ∧ #j < #i) ∧
        (∀ S2 I2 #i2. (Commit( S2, I2, pk(~k) ) @ #i2) ⇒ #i = #i2)) )
  case case_2
  solve( ClientState( $S, ~I, %local, <'registering', ~k> ) ▶₀ #i )
    case Client_register_1
    solve( !Pk( $S, pk(x) ) ▶₁ #i )
      case Register_pk
      solve( LtkReveal( ~I ) @ #r )
        case Reveal_client
        solve( !ClientKey( ~I, ~k.1 ) ▶₀ #r )
          case Client_register_2
          solve( !KU( sign(<'REG_SUCCESS', h(~I)>, ~ltk) ) @ #vk.4 )
            case Server_register
            solve( !KU( ~admin.1 ) @ #vk.12 )
              case Client_register_1
              solve( !KU( sign(<'REGISTER', ~I, pk(x), ~admin.1>, x) ) @ #vk.14 )
                case Client_register_1
                solve( !KU( ~I ) @ #vk.12 )
                  case Client_register_1
                  solve( !KU( sign(sign(<'REGISTER', ~I, pk(~k), ~admin>, ~k),
                                   ~admin_k)
                         ) @ #vk.15 )
                    case Client_register_1
                    solve( !KU( h(~I) ) @ #vk.13 )
                      case Server_register
                      solve( !KU( pk(~k) ) @ #vk.15 )
                        case Client_register_1
                        SOLVED // trace found
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma Exists_cycle_trace:
  exists-trace
  "∃ S I k1 k2 #i.
    (SessionKeyRhangeover( S, I, k1, k2 ) @ #i) ∧
    (¬(∃ #r. LtkReveal( S ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
"∃ S I k1 k2 #i.
  (SessionKeyRhangeover( S, I, k1, k2 ) @ #i)
 ∧
  ∀ #r. (LtkReveal( S ) @ #r) ⇒ ⊥"
*/
simplify
solve( ClientState( $S, ~I, %local, <'cycling', ~k, ~oldK>
       ) ▶₀ #i )
  case Client_cycle_1
  solve( (∃ #r. (LtkReveal( $S ) @ #r))  ∥
         (∃ #r. (LtkReveal( ~I ) @ #r))  ∥
         ((∃ #j. (Running( $S, ~I, pk(~oldK) ) @ #j) ∧ #j < #vr.1) ∧
          (∀ S2 I2 #i2. (Commit( S2, I2, pk(~oldK) ) @ #i2) ⇒ #vr.1 = #i2)) )
    case case_2
    solve( !Pk( $S, pk(x) ) ▶₁ #i )
      case Register_pk
      solve( LtkReveal( ~I ) @ #r )
        case Reveal_client
        solve( !ClientKey( ~I, ~k.1 ) ▶₀ #r )
          case Client_cycle_2
          solve( !KU( sign(<'CYCLE_OK', h(<~I, pk(~k)>)>, ~ltk) ) @ #vk.4 )
            case Serv_cycle_1
            solve( !KU( ~admin.1 ) @ #vk.25 )
              case Client_register_1
              solve( !KU( sign(<'REG_SUCCESS', h(~I)>, ~ltk.2) ) @ #vk.10 )
                case Server_register
                solve( !KU( sign(sign(<'CYCLE', ~I, pk(~k)>, ~k), x) ) @ #vk.23 )
                  case Client_cycle_1
                  solve( !KU( sign(<'REGISTER', ~I, pk(~oldK), ~admin>, ~oldK)
                         ) @ #vk.27 )
                    case Client_register_1
                    solve( Cycle( ~I, %count, ~oldK ) ▶₂ #i )
                      case Client_register_2
                      solve( !KU( ~I ) @ #vk.23 )
                        case Client_register_1
                        solve( !KU( sign(<'CYCLE', ~I, pk(~k)>, ~k) ) @ #vk.25 )
                          case Client_cycle_1
                          solve( !KU( sign(sign(<'REGISTER', ~I, pk(~oldK), ~admin>, ~oldK),
                                           ~admin_k)
                                 ) @ #vk.28 )
                            case Client_register_1
                            solve( !KU( h(<~I, pk(~k)>) ) @ #vk.21 )
                              case Serv_cycle_1
                              solve( !KU( h(~I) ) @ #vk.24 )
                                case Server_register
                                solve( !KU( pk(~k) ) @ #vk.26 )
                                  case Client_cycle_1
                                  solve( !KU( pk(~oldK) ) @ #vk.28 )
                                    case Client_register_1
                                    SOLVED // trace found
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma SessionKeyPreceededByOwnership [reuse]:
  all-traces
  "∀ S I k #x.
    (SessionKey( S, I, k ) @ #x) ⇒
    (∃ #y. (OwnsKey( I, k ) @ #y) ∧ (#y < #x))"
/*
guarded formula characterizing all counter-examples:
"∃ S I k #x.
  (SessionKey( S, I, k ) @ #x)
 ∧
  ∀ #y. (OwnsKey( I, k ) @ #y) ⇒ ¬(#y < #x)"
*/
simplify
solve( SessionKey( S, I, k ) @ #x )
  case Client_cycle_2
  solve( ClientState( $S, ~I, %local, <'cycling', ~k, ~oldK>
         ) ▶₀ #x )
    case Client_cycle_1
    by contradiction /* from formulas */
  qed
next
  case Client_register_2
  solve( (∃ #r. (LtkReveal( $S ) @ #r))  ∥
         (∃ #r. (LtkReveal( ~I ) @ #r))  ∥
         ((∃ #j. (Running( $S, ~I, pk(~k) ) @ #j) ∧ #j < #x) ∧
          (∀ S2 I2 #i2. (Commit( S2, I2, pk(~k) ) @ #i2) ⇒ #x = #i2)) )
    case case_1
    solve( ClientState( $S, ~I, %local, <'registering', ~k> ) ▶₀ #x.1 )
      case Client_register_1
      by contradiction /* from formulas */
    qed
  next
    case case_2
    solve( ClientState( $S, ~I, %local, <'registering', ~k> ) ▶₀ #x.1 )
      case Client_register_1
      by contradiction /* from formulas */
    qed
  next
    case case_3
    solve( ClientState( $S, ~I, %local, <'registering', ~k> ) ▶₀ #x.1 )
      case Client_register_1
      by contradiction /* from formulas */
    qed
  qed
qed

lemma SessionKeyRel:
  all-traces
  "∀ S I newK oldK #x.
    (SessionKeyRhangeover( S, I, newK, oldK ) @ #x) ⇒
    (∃ #y. SessionKey( S, I, newK ) @ #y)"
/*
guarded formula characterizing all counter-examples:
"∃ S I newK oldK #x.
  (SessionKeyRhangeover( S, I, newK, oldK ) @ #x)
 ∧
  ∀ #y. (SessionKey( S, I, newK ) @ #y) ⇒ ⊥"
*/
simplify
by contradiction /* from formulas */

