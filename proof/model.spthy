lemma Exists_register_trace:
    exists-trace
    "
    Ex S I k #i.
        Registered(S, I, k) @ i
        & not(Ex #r. LtkReveal(S) @ r)
    "

lemma Exists_up_to_server_trace:
  exists-trace
  "
  Ex S I k_new k_old admin_pk #j #i.
      NewClientRegistry(S, I, k_old, admin_pk) @ #j
        & #j < #i
        & AnswerCycleRequest(S, I, k_new, k_old) @ #i
        & not (Ex #r. LtkReveal(S) @ r)
         
  "

lemma Exists_full_cycle:
  exists-trace
  "
  Ex S I sk_new pk_old admin_pk #reg #cyc #sess.
      NewClientRegistry(S, I, pk_old, admin_pk) @ #reg
    & #reg < #cyc
    & #cyc < #sess
    & AnswerCycleRequest(S, I, pk(sk_new), pk_old) @ #cyc
    & SessionKey(S, I, sk_new) @ #sess
    & not (Ex #r. LtkReveal(S) @ #r)
  "

    // "
    // Ex S I k1 k2 #i.
    //     SessionKeyRhangeover(S, I, k1, k2) @ #i
    //     // &  not (Ex #r. LtkReveal(S) @ r)
    
    // "


// LEMMA: This lemma establishes that a session key is safe as long
// as it is not revealed.
lemma SecrecyForward [reuse, use_induction]:
    "
    All S I k #i.
        /* A session key is established. */
        SessionKey(S, I, k) @ #i
        /* The client was not revealed */
        & not(Ex #r. LtkReveal(I) @ #r)
        /* The key was not invalidated */
        & not(Ex #r. InvalidateKey(I, k) @ #r)
        /* then the attacker does not have it */
        ==> not(Ex #j. K(k) @ #j)
    "






end